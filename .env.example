# GEMINI_API_KEY: Required for live server-side Gemini AI Agricultural Advisor calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: Public URL of this deployment for CORS and self-referential links.
APP_URL="http://localhost:3000"

# PORT: Server port (must remain 3000 in AI Studio preview).
PORT="3000"

# SESSION_SECRET: Secret key for signing HTTP-only session cookies.
# Leave unset in development to use an ephemeral runtime secret, or set a strong random string in production.
SESSION_SECRET=""

# DB_PATH: Isolated SQLite database path for the Node.js runtime server.
DB_PATH="./data/agri_advisory.db"

# AI & Security Limits
AI_ANON_DAILY_LIMIT="5"
AI_AUTH_HOURLY_LIMIT="30"
AI_TIMEOUT_MS="20000"

# Companion PHP 8.3 + MySQL 8 Configuration (for local macOS/XAMPP deployment)
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_DATABASE="team8_agri_advisory"
MYSQL_USER="agri_user"
MYSQL_PASSWORD=""
APP_ENV="development"
